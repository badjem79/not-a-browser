# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat model/binary artifacts as binary (defensive; they're gitignored anyway)
*.gguf binary
*.onnx binary
*.safetensors binary
*.bin binary
*.png binary
*.ico binary
*.icns binary
