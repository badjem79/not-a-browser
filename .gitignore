# ─────────────────────────────────────────────────────────────
# !aBrowser — root .gitignore
# ─────────────────────────────────────────────────────────────

# --- Node / frontend (Vite) ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Rust / Tauri build artifacts ---
target/
**/target/
# Tauri-generated schemas
src-tauri/gen/schemas/

# --- AI model weights & downloaded artifacts (large, fetched by the setup wizard) ---
# Never commit multi-GB weights; they are downloaded, not source.
models/
src-tauri/models/
*.gguf
*.onnx
*.safetensors
*.bin
*.pt
*.ggml
# ...but DO keep tiny tokenizer/config JSON if ever vendored intentionally:
!**/tokenizer_config.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Misc / local tooling ---
*.tmp
scratchpad/
